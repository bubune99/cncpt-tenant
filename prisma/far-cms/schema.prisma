  @@index([tenantId])
}

enum EmailEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXITED
}

model EmailAutomationEnrollmentStep {
  id           String @id @default(cuid())
  tenantId Int? @map("tenant_id")
