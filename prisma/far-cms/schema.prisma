  shopProductIds String[] @default([]) @map("shop_product_ids")
  series       BlogPostSeries[]
  contributors BlogContributor[]
  relatedPosts BlogPostRelated[]       @relation("PostRelated")
  relatedOf    BlogPostRelated[]       @relation("RelatedPost")
  channels     PostDistributionChannel[]

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@index([featured])
  @@index([homeOrder])
  @@map("blog_posts")
  @@unique([tenantId, slug]) // Unique slugs per tenant
  @@index([tenantId])
}

enum BlogPostStatus {
