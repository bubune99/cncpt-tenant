// =============================================================================
// FORMS (Dynamic Form Builder)
// =============================================================================

model Form {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?

  // Form schema (JSON Schema format)
  fields Json // Array of field definitions

  // Settings
  submitButtonText String  @default("Submit")
  successMessage   String? @default("Thank you for your submission!")
  redirectUrl      String?

  // Display behavior: how the form appears on the storefront by default
  // { mode: "inline"|"popup", popupDelay, popupFrequency, popupDuration }
  // Block-level attrs (data-display etc.) override per placement.
  display Json?

  // Notifications
  notifyEmails String[] @default([])

  // Automations: declarative rules (lib/forms/automations) — WHEN someone
  // submits [+ an answer matches] → THEN registered actions. Data, never code.
  automations Json?

  // Spam protection (Cloudflare Turnstile) for this form — on by default.
  // Honeypot, time check and rate limit apply either way (lib/forms/spam).
  captchaEnabled Boolean @default(true)

  // How long submissions are kept, in months (1–120). null = the site default
  // (24). The nightly purge (lib/privacy) deletes older ones.
  retentionMonths Int?

  // Status
  status FormStatus @default(ACTIVE)

  // Analytics
  submissionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submissions FormSubmission[]
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([status])
  @@map("forms")
  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum FormStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model FormSubmission {
  id     String @id @default(cuid())
  formId String

  // Submission data
  data Json // The submitted form data

  // Metadata
  ipAddress String?
  userAgent String?
  referrer  String?

  // Status
  read    Boolean @default(false)
  starred Boolean @default(false)
  // Inbox state: new | read | replied | archived (`read` is kept in sync).
  status  String   @default("new")
  notes   String?  @db.Text
  tags    String[] @default([])

  createdAt DateTime @default(now())

  // Relations
  form Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  runs FormRuleRun[]
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@index([formId, status])
  @@map("form_submissions")
  @@index([tenantId])
}

// One automation action on one submission — the "What happened" timeline.
// dedupeKey is set only when an action really ran (or waits for approval),
// so the same action never reaches the same submission twice.
model FormRuleRun {
  id           String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FormRuleRun", fields: [tenantId], references: [id], onDelete: Cascade)
  formId       String
  submissionId String
  // null for a one-off action run from Submissions
  ruleId       String?
  ruleName     String?
  actionType   String
  actionKey    String
  // done | skipped | failed | needs_approval | approved | declined
  status       String
  detail       String?  @db.Text
  // auto | bulk | test
  source       String   @default("auto")
  jobId        String?
  dedupeKey    String?  @unique
  createdAt    DateTime @default(now())

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([formId, ruleId])
  @@index([jobId])
  @@map("form_rule_runs")

  @@index([tenantId])
}

// Submissions per (hashed IP, form, 10-minute window) — the form spam rate
// limit. The raw IP is never stored. Old windows are pruned as it runs.
model FormRateLimit {
  key         String   @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FormRateLimit", fields: [tenantId], references: [id], onDelete: Cascade)
  formId      String
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
  @@map("form_rate_limits")

  @@index([tenantId])
}

// A bulk run over past submissions: previewed first, run in small batches,
// stoppable part-way. Relation-free (the form may be deleted; the record stays).
model FormBulkJob {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FormBulkJob", fields: [tenantId], references: [id], onDelete: Cascade)
  formId      String
  title       String
  // { submissionIds, actions, ruleId?, ruleName? }
  spec        Json
  total       Int
  cursor      Int      @default(0)
  ran         Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  // running | stopped | done
  status      String   @default("running")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([formId, createdAt])
  @@map("form_bulk_jobs")

  @@index([tenantId])
}

