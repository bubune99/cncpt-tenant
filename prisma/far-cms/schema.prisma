  @@index([stepId])
  @@index([status])
  @@index([scheduledFor])
  @@map("email_automation_enrollment_steps")

  @@index([tenantId])
}

enum EmailStepExecutionStatus {
  PENDING
  SCHEDULED
  EXECUTED
  SKIPPED
  FAILED
}

