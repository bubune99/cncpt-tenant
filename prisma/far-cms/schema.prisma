// =============================================================================
// EVENTS
// =============================================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  WAITLISTED
}

model Event {
  id               String      @id @default(cuid())
  title            String
  slug             String
  description      String?     @db.Text
  shortDescription String?
  eventType        EventType   @default(IN_PERSON)
  status           EventStatus @default(DRAFT)

  startDate DateTime
  endDate   DateTime
  timezone  String   @default("UTC")

  // Location (in-person / hybrid)
  venueName    String?
  venueAddress String?
  venueCity    String?
  venueState   String?
  venueCountry String?
  venueZip     String?
  latitude     Float?
  longitude    Float?

  // Virtual
  virtualUrl      String?
  virtualPlatform String? // zoom, meet, teams, custom

  // Media
  featuredImageUrl String?
  coverImageUrl    String?

  // Capacity
  maxAttendees      Int @default(0) // 0 = unlimited
  registrationCount Int @default(0)

  // Organizer
  organizerName  String?
  organizerEmail String?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ticketTypes   EventTicketType[]
  scheduleItems EventScheduleItem[]
  speakers      EventSpeaker[]
  registrations EventRegistration[]
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([status])
  @@index([startDate])
  @@index([eventType])
  @@map("events")
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model EventTicketType {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Int     @default(0) // cents, 0 = free
  currency    String  @default("usd")
  quantity    Int?    // null = unlimited
  sold        Int     @default(0)
  maxPerOrder Int     @default(10)
  salesStart  DateTime?
  salesEnd    DateTime?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  // Stripe
  stripeProductId String?
  stripePriceId   String?

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_ticket_types")
  @@index([tenantId])
}

model EventScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  location    String?
  day         Int      @default(1)
  position    Int      @default(0)

  speakerId String?
  speaker   EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([day])
  @@map("event_schedule_items")
  @@index([tenantId])
}

model EventSpeaker {
  id        String  @id @default(cuid())
  eventId   String
  name      String
  title     String?
  bio       String? @db.Text
  avatarUrl String?
  company   String?
  website   String?
  twitter   String?
  linkedin  String?
  position  Int     @default(0)

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scheduleItems EventScheduleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_speakers")
  @@index([tenantId])
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  ticketTypeId String?
  status       RegistrationStatus @default(PENDING)

  // Attendee info
  attendeeName  String
  attendeeEmail String
  attendeePhone String?

  // Payment
  amount          Int    @default(0) // cents
  currency        String @default("usd")
  stripePaymentId String?
  stripeSessionId String?

  // Check-in
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  // Metadata
  notes String?

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([attendeeEmail])
  @@index([status])
  @@map("event_registrations")
  @@index([tenantId])
}

// =============================================================================
// CANVA INTEGRATION
// =============================================================================

model CanvaConnection {
  id             String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_CanvaConnection", fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String   @unique
  accessToken    String   @db.Text // Encrypted via src/lib/encryption
  refreshToken   String   @db.Text // Encrypted
  tokenExpiresAt DateTime
  canvaUserId    String?
  canvaTeamId    String?
  scopes         String[] // Granted OAuth scopes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("canva_connections")

  @@index([tenantId])
}

// =============================================================================
// TOUR LIBRARY — Spotlight tour persistence (per-tenant + cross-tenant marketplace)
//
// `Tour` is the per-tenant spotlight tour record consumed by dzidzor's
// spotlight system. The `steps` JSON is opaque here — runtime types
// (SpotlightStep) live in `src/components/spotlight/types.ts` and validation
// happens in `src/lib/db/tours.ts`.
//
// Distinct from the legacy `HelpTour` model (Joyride-based) above.
// =============================================================================

model Tour {
  id          String         @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_Tour", fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String // url-safe: "create-product", "publish-blog-post"
  title       String
  description String?        @db.Text
  steps       Json           // SpotlightStep[] — opaque JSON; runtime types in src/components/spotlight/types.ts
  status      TourStatus     @default(DRAFT)
  authorId    String?        // FK to User (nullable for system-seeded tours)
  visibility  TourVisibility @default(TENANT) // TENANT, PUBLIC (cross-tenant), DRAFT
  metadata    Json?          // { estimatedMinutes, persona, surface, etc. }
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  runs        TourRun[]

  @@index([slug])
  @@index([status, visibility])
  @@map("tours")

  @@index([tenantId])
  @@unique([tenantId, slug])
}

enum TourStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TourVisibility {
  TENANT // visible to this tenant's users only
  PUBLIC // available cross-tenant via marketplace
  DRAFT  // only the author sees it
}

model TourRun {
  id          String        @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_TourRun", fields: [tenantId], references: [id], onDelete: Cascade)
  tourId      String
  tour        Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  userId      String?       // anonymous runs allowed
  status      TourRunStatus
  currentStep Int           @default(0)
  totalSteps  Int
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  abandonedAt DateTime?
  metadata    Json?         // { userAgent, referrer, dropoffStep }

  @@index([tourId, status])
  @@index([userId])
  @@map("tour_runs")

  @@index([tenantId])
}

enum TourRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// =============================================================================
// CMS MODULES — DB-driven feature toggles
// =============================================================================

model CmsModule {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_CmsModule", fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?  @db.Text
  icon        String?
  version     String   @default("1.0.0")
  manifest    Json     // ModuleManifest — routes, blocks, settings, permissions
  enabled     Boolean  @default(true)
  builtIn     Boolean  @default(true)
  config      Json?    // User-changeable module config (e.g., commerce provider)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([slug])
  @@map("cms_modules")

  @@index([tenantId])
  @@unique([tenantId, slug])
}

// =============================================================================
// ADE (agent development environment) — src/lib/ade/*
// Deliberately relation-free (ids only, string statuses) so these tables can be
// lifted into the shared @cncpt/cms package without dragging Dzidzor models.
// =============================================================================

// A batch of agent-proposed changes awaiting human review (draft mode).
model AdeChangeSet {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeChangeSet", fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String   @default("default")
  // The user the agent acted for (chat user, or the MCP key's user).
  ownerId     String?
  // chat | mcp | workflow
  source      String
  title       String
  rationale   String?  @db.Text
  // pending | partial | approved | rejected | saved  (derived from items)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    AdeChangeSetItem[]
  comments AdeChangeComment[]

  @@index([workspaceId, status, createdAt])
  @@index([ownerId])
  @@map("ade_change_sets")

  @@index([tenantId])
}

// One proposed mutation: before/after snapshots of the target.
model AdeChangeSetItem {
  id          String    @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeChangeSetItem", fields: [tenantId], references: [id], onDelete: Cascade)
  changeSetId String
  // page | blog-post
  targetType  String
  // null for creates
  targetId    String?
  // create | update
  operation   String
  // pages | blog — the earned-autonomy bucket (bulk approve per category)
  category    String
  toolName    String
  input       Json
  before      Json?
  after       Json?
  // Block ids touched (page content edits) — drives the preview spotlight.
  blockIds    String[]  @default([])
  rationale   String?   @db.Text
  // pending | approved | rejected | saved | stale | failed
  status      String    @default("pending")
  error       String?   @db.Text
  // id of the entity created/updated on apply
  resultId    String?
  // The version its apply recorded (ade_revisions id, or a page's PageRevision id).
  revisionId  String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  changeSet AdeChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@index([changeSetId])
  @@index([status, category])
  @@index([targetType, targetId])
  @@index([revisionId])
  @@map("ade_change_set_items")

  @@index([tenantId])
}

// Reviewer comments; kind=revise asks the agent to rework the item.
model AdeChangeComment {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeChangeComment", fields: [tenantId], references: [id], onDelete: Cascade)
  changeSetId String
  itemId      String?
  authorId    String?
  authorEmail String?
  // comment | revise
  kind        String   @default("comment")
  body        String   @db.Text
  createdAt   DateTime @default(now())

  changeSet AdeChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@index([changeSetId, createdAt])
  @@map("ade_change_comments")

  @@index([tenantId])
}

// Daily task list entry, generated from real signals (src/lib/ade/tasks).
model AdeTask {
  id          String    @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeTask", fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String    @default("default")
  // Assigned user, or null = anyone holding `role`/permission.
  userId      String?
  // RBAC permission that makes this task relevant (e.g. "pages.edit").
  permission  String?
  // pending-changes | form-submissions | stale-drafts | broken-media | failed-jobs
  source      String
  title       String
  detail      String?   @db.Text
  href        String?
  targetType  String?
  targetId    String?
  // Stable key so regeneration updates instead of duplicating.
  dedupeKey   String    @unique
  priority    Int       @default(2)
  // open | done | dismissed
  status      String    @default("open")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, status, priority])
  @@index([userId, status])
  @@map("ade_tasks")

  @@index([tenantId])
}

// Per-user ADE UI preferences (split-pane ratio, etc.).
// Coverage check (lib/ade/coverage): the latest result per admin route —
// what the agent can't do there, what the screen hides, what only hidden UI
// reaches. Written by the read-only coverage runner; a sweep reads them all.
model AdeCoverage {
  id        String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeCoverage", fields: [tenantId], references: [id], onDelete: Cascade)
  route     String   @unique
  // CoverageRow + per-unit detail + tour steps (lib/ade/coverage)
  result    Json
  units     Int      @default(0)
  toolGaps  Int      @default(0)
  uiGaps    Int      @default(0)
  hidden    Int      @default(0)
  runBy     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("ade_coverage")

  @@index([tenantId])
}

model AdeUserPref {
  userId     String   @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeUserPref", fields: [tenantId], references: [id], onDelete: Cascade)
  splitRatio Float?
  prefs      Json?
  updatedAt  DateTime @updatedAt

  @@map("ade_user_prefs")

  @@index([tenantId])
}

// A record of a registered type (src/lib/ade/records): structured facts that
// placements (bound blocks) render; the record owns one page (pageId).
// Relation-free on purpose (see the ADE block above).
model AdeRecord {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeRecord", fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String   @default("default")
  // RecordTypeDef.key, e.g. "initiative"
  type        String
  slug        String
  // DRAFT | PUBLISHED | ARCHIVED
  status      String   @default("DRAFT")
  /// Goes live (record + its page) on its own at this time; null = not scheduled. Owner 2026-10-20.
  scheduledAt DateTime?
  // Field values, validated against the type definition
  data        Json
  // The record's own CMS page (two-way: the page's bound blocks carry data-record)
  pageId      String?
  // Where it came from when migrated (e.g. "blog-post:<id>")
  legacyRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, workspaceId, type, slug])
  @@index([type, status])
  @@index([scheduledAt])
  @@index([pageId])
  @@index([legacyRef])
  @@map("ade_records")

  @@index([tenantId])
}

// One person edits a page/record at a time (src/lib/ade/locks). A row is the
// live claim on a target ("page:<id>", "record:<id>", "partial:<id>",
// "layout:header"): who holds it, from which browser tab, and when they were
// last active. A claim whose heartbeat is older than the TTL is free to take.
// The assistant acts for its user, so it shares that user's claim.
model AdeEditLock {
  targetKey       String    @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeEditLock", fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  userName        String?
  tabId           String
  acquiredAt      DateTime  @default(now())
  heartbeatAt     DateTime
  requestedById   String?
  requestedByName String?
  requestedAt     DateTime?

  @@index([userId])
  @@map("ade_edit_locks")

  @@index([tenantId])
}

// =============================================================================
// AGENT ACTIVITY (lib/ade/observability) — one AgentRun per assistant turn,
// its timeline as AgentSpans. Written in ONE batch when the turn ends.
// Inputs are redacted and capped; purged after 90 days (privacy inventory).
// =============================================================================

model AgentRun {
  id               String    @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AgentRun", fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId   String?
  messageId        String?
  userId           String?
  area             String?
  route            String?
  /// The person's request, redacted and capped (200 chars).
  request          String?
  model            String?
  effort           String?
  startedAt        DateTime
  endedAt          DateTime?
  /// ok | error | aborted | budget
  status           String
  /// The run read outside text (lib/ade/governance/taint): every change after it needed approval.
  tainted          Boolean   @default(false)
  /// The tool whose result tainted it (name only).
  taintedBy        String?
  steps            Int       @default(0)
  tokensIn         Int       @default(0)
  tokensOut        Int       @default(0)
  cacheRead        Int       @default(0)
  cacheWrite       Int       @default(0)
  /// tokensIn + tokensOut, and endedAt - startedAt — kept so the list can sort by them.
  tokens           Int       @default(0)
  durationMs       Int       @default(0)
  costEstimate     Float     @default(0)
  toolGroupsLoaded String[]  @default([])
  /// Spans dropped past the per-run cap.
  droppedSpans     Int       @default(0)
  error            String?

  spans AgentSpan[]

  @@index([userId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
  @@index([conversationId])
  @@map("agent_runs")

  @@index([tenantId])
}

model AgentSpan {
  id            String  @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AgentSpan", fields: [tenantId], references: [id], onDelete: Cascade)
  runId         String
  parentId      String?
  /// Order within the run.
  seq           Int
  /// agent | model | tool | io
  kind          String
  label         String
  /// Offsets from the run start, in ms.
  startMs       Int
  endMs         Int
  /// ok | error | cached
  status        String
  attempt       Int     @default(1)
  tokens        Int     @default(0)
  detail        String?
  /// read | draft | write | irreversible (tool labels)
  effect        String?
  /// This call tainted the run, or was a change made after it was tainted.
  tainted       Boolean @default(false)
  changeSetId   String?
  auditLogId    String?
  inputRedacted Json?
  outputSummary String?
  /// The AI SDK tool-call id, for calls the browser answers (read_view…): the
  /// continuation request carries its result and joins this run.
  callId        String?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([callId])
  @@map("agent_spans")

  @@index([tenantId])
}

/// A parked run waiting on the person (lib/ade/chat/waits): spotlight step,
/// question form, plan Go, card Approve/Reject. Only the token's sha256 is
/// stored; the ack event resumes the run. Expires after 24 h; purged with
/// agent activity (90 days).
model AdeWait {
  id             String    @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeWait", fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  runId          String
  conversationId String?
  callId         String
  stepId         String
  /// spotlight | ask | plan | card
  kind           String
  /// What the step shows (target, title, sentence, index/total), capped — so a reload can show it again.
  step           Json?
  tokenHash      String    @unique
  /// waiting | acked | expired
  status         String    @default("waiting")
  /// got_it | next | skip | stop | back | done
  action         String?
  /// The tool result the server hands back on resume.
  output         Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  ackedAt        DateTime?

  @@index([userId, status])
  @@index([userId, callId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("ade_waits")

  @@index([tenantId])
}

// =============================================================================
// VERSIONING & HISTORY (lib/ade/history) — one row per change to an editable
// entity: the changed top-level fields before/after (secrets never stored).
// Version is monotonic per entity; restoring writes a NEW version.
// Pages keep their full snapshots in page_revisions (bridged, not copied).
// =============================================================================

model AdeRevision {
  id           String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeRevision", fields: [tenantId], references: [id], onDelete: Cascade)
  /// form | page | partial | site-setting | settings:<group> | blog-post | …
  entityType   String
  entityId     String
  version      Int
  changed      String[]
  before       Json
  after        Json
  /// user | agent | system
  actorKind    String
  actorUserId  String?
  runId        String?
  changeSetId  String?
  /// save | ai-edit | restore of vN | changed outside history | …
  reason       String?
  /// The entity's history schema when this was written (its restore policy migrates older ones forward)
  schemaVersion Int     @default(1)
  /// A restore's record: { restoredFrom, restored[], skipped[{field, reason}], followUps[] }
  meta         Json?
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("ade_revisions")

  @@index([tenantId])
}

/// Work started on one device and picked up on another ("You started an initiative on your phone").
/// Keyed by the draft (change set) and the conversation it came from (lib/ade/mobile/handoff).
model AdeHandoff {
  id             String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_AdeHandoff", fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  /// What was started: initiative | listing | …
  kind           String
  title          String
  /// phone | desktop
  device         String   @default("phone")
  changeSetId    String?
  conversationId String?
  /// Where to continue (an admin path).
  href           String?
  /// open | picked | dismissed
  status         String   @default("open")
  /// The phone's draft key: a save retried after a dropped signal finds this row instead of saving twice.
  clientKey      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, status, createdAt])
  @@index([changeSetId])
  @@map("ade_handoffs")

  @@index([tenantId])
}

/// A person's own mailbox connection (lib/ade/connectors). Visible only to
/// that person and their own assistant. Tokens and the account address are
/// encrypted with lib/encryption (AES-256-GCM).
model ConnectorAccount {
  id              String    @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_ConnectorAccount", fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  /// google | microsoft
  provider        String
  /// personal (a 'shared' team inbox with an allow-list is not built)
  scope           String    @default("personal")
  /// The mailbox address, encrypted (only its owner sees it).
  accountEnc      String?   @db.Text
  grantedScopes   String[]  @default([])
  accessTokenEnc  String    @db.Text
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime?
  /// active | needs-reconnect
  status          String    @default("active")
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, scope])
  @@index([userId])
  @@map("connector_accounts")

  @@index([tenantId])
}

// Feedback from the people who run the site to the site's builder (the owner):
// the "Send feedback" button and the assistant's send_feedback_to_owner. Always
// stored first; forwarding (planner + email) happens after, so nothing is lost.
model ClientFeedback {
  id                String    @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_ClientFeedback", fields: [tenantId], references: [id], onDelete: Cascade)
  createdById       String
  // Where it was sent from (pathname + search).
  route             String
  // The screen's name as the person sees it ("Initiatives › Edit"), for the owner's planner/email.
  screen            String    @default("")
  // Display name of the sender at the time (never their email — forwarding only shows this).
  senderName        String    @default("")
  // The sender's idempotency key (`<userId>:<offline queue item id>`): a retried send returns the first row.
  dedupeKey         String?   @unique
  // The part it is about: a functional unit's label / stable selector — never private text.
  unitRef           String?
  note              String    @db.Text
  // Optional screenshot: a FeedbackScreenshot id (private bytes, admin-only route — never a
  // public Media file). Captured with the visibility policy's masks. (Name kept from v1.)
  screenshotMediaId String?
  // bug | confusing | idea | praise
  kind              String
  // new | sent | triaged
  status            String    @default("new")
  forwardedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, createdAt])
  @@index([createdById])
  @@map("client_feedback")

  @@index([tenantId])
}

/// Forwarding of one client-feedback item to one channel (lib/ade/feedback/forward):
/// claimed before sending, so nothing is sent twice. No FK: the feedback table is owned elsewhere.
model FeedbackDelivery {
  id            String    @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FeedbackDelivery", fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackId    String
  /// planner | email
  channel       String
  /// pending | sending | sent | failed | not-set-up
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedUntil   DateTime?
  /// Planner todo id / provider message id.
  externalId    String?
  /// Short, key-free reason (errorSummary).
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([feedbackId, channel])
  @@index([status, nextAttemptAt])
  @@map("feedback_deliveries")

  @@index([tenantId])
}

/// One row per day the client-feedback digest email went out (at most once a day).
model FeedbackDigest {
  /// yyyy-mm-dd (UTC) of the feedback it covered
  day    String   @id
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FeedbackDigest", fields: [tenantId], references: [id], onDelete: Cascade)
  count  Int
  sentAt DateTime @default(now())

  @@map("feedback_digests")

  @@index([tenantId])
}

/// A client-feedback screenshot, stored PRIVATELY (bytes in the DB, served only by
/// /api/admin/feedback/screenshots/{id} behind a sign-in) — never in the public media bucket.
model FeedbackScreenshot {
  id          String   @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant Subdomain? @relation("site_FeedbackScreenshot", fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  /// image/jpeg | image/png | image/webp (sniffed from the bytes)
  contentType String
  size        Int
  bytes       Bytes
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@map("feedback_screenshots")

  @@index([tenantId])
}

model OrderItemFulfillmentStep {
  id          String    @id @default(cuid())
  orderItemId String @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  name        String   // "Pick blank", "Confirm spec", "Embroider", "QC", "Pack"
  position    Int      @default(0)
  completed   Boolean  @default(false)
  completedAt DateTime? @map("completed_at")
  completedBy String? @map("completed_by") // userId
  notes       String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderItemId])
  @@map("order_item_fulfillment_steps")
}

model PageVersion {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Multi-tenant scoping — mirrors Page's tenant relation exactly.
  tenantId Int?       @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  content   Json?
  title     String
  status    PageStatus @default(DRAFT)
  createdBy String?
  createdAt DateTime   @default(now())

  @@index([pageId, createdAt])
  @@index([tenantId])
  @@map("page_versions")
}

model WebhookEvent {
  id        String   @id // Use the Stripe event ID directly (e.g., evt_xxx)
  source    String   @default("stripe") // "stripe", "shopify", etc.
  type      String // Event type (e.g., "checkout.session.completed")
  processed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@map("webhook_events")
}

model OnboardingChecklist {
  id          String    @id @default(cuid())
  userId      String
  subdomainId Int
  items       Json // [{key, title, completed, completedAt, url}]
  dismissed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subdomain Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([userId, subdomainId])
  @@index([userId])
  @@map("onboarding_checklists")
}

model Feedback {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.VarChar(255)
  userEmail  String         @map("user_email") @db.VarChar(255)
  userName   String?        @map("user_name") @db.VarChar(255)
  tenantId   Int?           @map("tenant_id")
  tenant     Subdomain?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       FeedbackType   @default(GENERAL)
  subject    String?        @db.VarChar(255)
  message    String         @db.Text
  pageUrl    String?        @map("page_url") @db.VarChar(500)
  userAgent  String?        @map("user_agent") @db.Text
  status     FeedbackStatus @default(NEW)
  priority   Int            @default(0)
  adminNotes String?        @map("admin_notes") @db.Text
  resolvedBy String?        @map("resolved_by") @db.VarChar(255)
  resolvedAt DateTime?      @map("resolved_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([userId], map: "idx_feedback_user")
  @@index([tenantId], map: "idx_feedback_tenant")
  @@index([status], map: "idx_feedback_status")
  @@index([type], map: "idx_feedback_type")
  @@index([createdAt(sort: Desc)], map: "idx_feedback_created")
  @@map("feedback")
}

model MarketplaceTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  type        String   @default("component") // 'site' or 'component'
  category    String // e.g. 'hero', 'pricing', 'landing-page', 'saas'
  tags        String[] @default([])

  // Content — same Block[] format as Page.content
  blocks Json // Block[] JSON array
  jsx    String? @db.Text // Original JSX source (for code preview)

  // Display
  thumbnail  String? // Preview image URL (R2/S3)
  previewUrl String? // URL for live preview iframe

  // Provenance
  source    String  @default("custom") // 'hyperui', 'tailblocks', 'meraki', 'custom', etc.
  sourceUrl String? // Original URL where this was scraped/imported from
  license   String  @default("MIT") // SPDX license identifier
  author    String? // Original author or contributor name

  // Status & popularity
  isPublished Boolean @default(true)
  isFeatured  Boolean @default(false)
  usageCount  Int     @default(0) // Incremented when a user inserts this template

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, category])
  @@index([isPublished, isFeatured])
  @@index([source])
  @@index([usageCount])
  @@map("marketplace_templates")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String? @map("author_id") // admin userId
  content    String   @db.Text
  pinned     Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_notes")
}

model ProductPricingTier {
  id        String          @id @default(cuid())
  productId String @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String          // "B2B Wholesale", "Studio Members"
  minQty    Int @map("min_qty") // minimum quantity to qualify
  maxQty    Int? @map("max_qty")
  price     Int             // price in cents at this tier
  type      PricingTierType @default(QTY)
  enabled   Boolean         @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_pricing_tiers")
}

model ProductSaleSchedule {
  id        String  @id @default(cuid())
  productId String @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String? @map("variant_id")
  salePrice Int @map("sale_price") // cents
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  enabled   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([startsAt, endsAt])
  @@map("product_sale_schedules")
}

model AnalyticsDashboard {
  id       String     @id @default(cuid())
  tenantId Int? @map("tenant_id")
  tenant   Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  slug       String
  isDefault  Boolean  @default(false) @map("is_default")
  layout     Json?    // grid layout (positions/sizes)
  pinnedBy   String[] @default([]) @map("pinned_by") // userIds who pinned
  sharedWith String[] @default([]) @map("shared_with") // "public" or userIds

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  widgets AnalyticsWidget[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("analytics_dashboards")
}

model AnalyticsWidget {
  id          String             @id @default(cuid())
  dashboardId String @map("dashboard_id")
  dashboard   AnalyticsDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  title      String
  vizType    String @map("viz_type") // "line", "bar", "donut", "kpi", "table", "funnel"
  query      Json    // { metric, dimension, filters, comparison, groupBy, dateRange }
  config     Json?   // chart-specific: axes, colors, drillEnabled
  position   Json    // { x, y, w, h } grid slot
  templateId String? @map("template_id") // if created from template

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dashboardId])
  @@map("analytics_widgets")
}

model AnalyticsWidgetTemplate {
  id          String     @id @default(cuid())
  tenantId    Int? @map("tenant_id")
  tenant      Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  vizType     String @map("viz_type")
  query       Json
  config      Json?
  thumbnail   String?
  category    String? // "Revenue", "Traffic", "Inventory"
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("analytics_widget_templates")
}

model BlogSeries {
  id           String     @id @default(cuid())
  tenantId     Int? @map("tenant_id")
  tenant       Subdomain? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  description  String?    @db.Text
  coverImageId String? @map("cover_image_id")
  postCount    Int        @default(0) @map("post_count")
  position     Int        @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts BlogPostSeries[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("blog_series")
}

model BlogPostSeries {
  postId   String @map("post_id")
  seriesId String @map("series_id")
  position Int        @default(0) // chapter number in series
  post     BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  series   BlogSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([postId, seriesId])
  @@map("blog_post_series")
}

model BlogContributor {
  postId   String @map("post_id")
  userId   String @map("user_id")
  role     String @default("author") // "author", "editor", "photographer"
  position Int    @default(0)
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("blog_contributors")
}

model BlogPostRelated {
  postId        String @map("post_id")
  relatedPostId String @map("related_post_id")
  position      Int      @default(0)
  post          BlogPost @relation("PostRelated", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost   BlogPost @relation("RelatedPost", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@id([postId, relatedPostId])
  @@map("blog_post_related")
}

model PostDistributionChannel {
  id          String               @id @default(cuid())
  postId      String @map("post_id")
  post        BlogPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel     DistributionChannel
  enabled     Boolean              @default(false)
  copy        String?              @db.Text // per-channel copy override
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  status      ChannelPublishStatus @default(DRAFT)
  metadata    Json?                // {tweetId, instagramMediaId, rssGuid, etc.}

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([postId, channel])
  @@index([postId])
  @@map("post_distribution_channels")
}

model LoyaltyActivity {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  tenantId   Int?     @map("tenant_id")

  // Event
  type        LoyaltyActivityType
  points      Int  // Positive = earned, negative = redeemed
  description String?
  referenceId String? @map("reference_id") // orderId, etc.

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@map("loyalty_activities")
}

enum CustomerLifecycleStage {
  NEW
  RETURNING
  LOYAL
  VIP
  LAPSED
  CHURNED

  @@map("customer_lifecycle_stage")
}

enum SystemPageKey {
  NOT_FOUND
  SERVER_ERROR
  MAINTENANCE
  COMING_SOON
}

enum PageTemplateType {
  SECTION // Reusable block or small group of components
  PAGE // Full page layout with multiple sections
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum PricingTierType {
  QTY    // B2B quantity break
  MEMBER // Member/loyalty tier pricing

  @@map("pricing_tier_type")
}

enum DistributionChannel {
  WEB
  NEWSLETTER
  RSS
  TWITTER_X
  MASTODON
  INSTAGRAM

  @@map("distribution_channel")
}

enum ChannelPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED

  @@map("channel_publish_status")
}

enum LoyaltyActivityType {
  EARNED_PURCHASE
  EARNED_REFERRAL
  EARNED_REVIEW
  REDEEMED
  ADJUSTED
  EXPIRED

  @@map("loyalty_activity_type")
}
