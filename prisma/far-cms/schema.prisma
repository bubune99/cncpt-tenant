// Subdomains table (main app managed)
model Subdomain {
  id        Int      @id @default(autoincrement())
  subdomain String   @unique
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Site status controls
  maintenanceMode Boolean @default(false) @map("maintenance_mode")
  maintenanceMsg  String? @map("maintenance_message") @db.Text

  // Feature enablement config (per-tenant overrides)
  // JSON: Record<featureKey, boolean> e.g. { "commerce": true, "commerce.reviews": false }
  featureConfig Json? @map("feature_config")

  // Platform-owner lifecycle + billing (additive 2026-06)
  // Soft-disable (suspend) — reversible. disabled=true blocks the tenant.
  disabled       Boolean   @default(false)
  disabledAt     DateTime? @map("disabled_at")
  disabledReason String?   @map("disabled_reason") @db.Text
  // Per-tenant plan assignment → drives quotas + rate-limit effective limits.
  subscriptionTierId String?           @map("subscription_tier_id") @db.Uuid
  subscriptionTier   SubscriptionTier? @relation("TenantTier", fields: [subscriptionTierId], references: [id], onDelete: SetNull)
  subscriptionStatus String?           @map("subscription_status") @db.VarChar(32)

  // Relations to tenant tables (legacy)
  tenantPosts    TenantPost[]
  tenantPages    TenantPage[]
  tenantSettings TenantSetting?

  // Relations to CMS content (new multi-tenant scoping)
  blogPosts            BlogPost[]
