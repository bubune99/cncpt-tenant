# cncpt-tenant — example environment configuration.
#
# Copy this to `.env` and fill in real values. None of the values committed
# here are secrets — they are placeholders / shape-illustration only.
#
# Convention:
#   REQUIRED  — app boots/builds without it but core flows (auth, DB, billing)
#               will not work.
#   OPTIONAL  — feature is gated; absence disables that feature gracefully.
#
# Do NOT commit a real .env file. The repo's .gitignore covers `.env*`.

# ============================================================================
# Database — REQUIRED
# Provisioned via Neon. The pooled URL goes to DATABASE_URL; the unpooled URL
# is used by Prisma migrations and any long-lived connections that bypass
# pgbouncer.
# ============================================================================
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Vercel/Postgres-template parallel names. Keep in sync with DATABASE_URL.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# ============================================================================
# Stack Auth — REQUIRED for sign-in / sign-up / dashboard
# Get these from https://app.stack-auth.com → your project.
# ============================================================================
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ============================================================================
# Vercel Edge Config — REQUIRED for custom-domain routing
# Provision via Vercel dashboard → Storage → Edge Config. The middleware
# reads custom-domain → tenant mappings from this config.
# ============================================================================
EDGE_CONFIG=
EDGE_CONFIG_ID=

# ============================================================================
# Vercel API — REQUIRED for tenant custom-domain CRUD via the dashboard
# Token must have project read+write scope on this project's team.
# ============================================================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# ============================================================================
# Public app config — REQUIRED
# ============================================================================
# Apex domain (no protocol, no port). Drives middleware subdomain detection.
NEXT_PUBLIC_ROOT_DOMAIN=cncptweb.com
# Public canonical URL used for callbacks / metadata / OG images.
NEXT_PUBLIC_APP_URL=https://cncptweb.com

# ============================================================================
# Super admin — REQUIRED for platform-admin pages
# Comma-separated emails. Match the value of `super_admins.email` in the DB
# for any user who should bypass tenant scoping.
# ============================================================================
SUPER_ADMIN_EMAILS=you@example.com

# ============================================================================
# Internal admin API key — REQUIRED for internal admin endpoints
# Use `openssl rand -base64 32` to generate.
# ============================================================================
ADMIN_API_KEY=

# ============================================================================
# Encryption key — REQUIRED if you store encrypted env vars in the DB
# 64 hex characters. Generate with `openssl rand -hex 32`.
# ============================================================================
ENCRYPTION_KEY=

# ============================================================================
# Redis / KV — REQUIRED for rate limiting + ephemeral subdomain storage
# Provisioned via Upstash or Vercel KV.
# ============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# ============================================================================
# Stripe — OPTIONAL until you accept payments
# Use sk_test_* / pk_test_* values during development.
# Ship live keys ONLY to the production Vercel environment.
# ============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IMPORTANT: the publishable key must be exposed to the browser, so it MUST
# carry the NEXT_PUBLIC_ prefix. The server-side STRIPE_PUBLISHABLE_KEY name
# (without the prefix) is NOT readable from client components — Stripe
# Elements will fail silently. Only the prefixed name is correct.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# Cloudflare R2 — OPTIONAL (image / media uploads)
# ============================================================================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ============================================================================
# AI providers — OPTIONAL (block-editor chat, content generation, AI tours)
# Configure whichever you actually use; leave the others unset.
# ============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=

# ============================================================================
# Email — OPTIONAL (transactional email, marketing campaigns)
# Pick exactly ONE provider; the others can stay empty.
# ============================================================================
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_PROVIDER=

# ============================================================================
# OAuth integrations — OPTIONAL
# ============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_USER_EMAIL=
OUTLOOK_ACCESS_TOKEN=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_ACCESS_TOKEN=

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ============================================================================
# Shipping — OPTIONAL (Shippo)
# ============================================================================
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=

# ============================================================================
# Misc OPTIONAL
# ============================================================================
# Set to `true` to put the public site into maintenance mode (admin/api still
# accessible). Useful during data migrations.
MAINTENANCE_MODE=
# Internal cron-job auth header.
CRON_SECRET=
# MCP super-admin key for the dashboard MCP integration.
MCP_API_KEY=
SUPER_ADMIN_MCP_KEY=
# Demo setup helper — used by scripts/seed-demo to bootstrap the demo tenant.
DEMO_SETUP_SECRET=
# Firecrawl API for content scraping features.
FIRECRAWL_API_KEY=
# Stack Auth webhook secret for sync/webhook endpoint.
STACK_AUTH_WEBHOOK_SECRET=
